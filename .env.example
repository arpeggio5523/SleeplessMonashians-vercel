SDOC_BUNDLE_PATH=sdoc-hackathon-bundle
SDOC_DB_PATH=data/sdoc.db

# --- Gemini fallback ---------------------------------------------------
# No key is required for normal use: the 27 classifications the model has
# already returned are committed under .cache/llm/. A key is only needed for
# prompts nobody has run yet - a new seed, or after editing a prompt.
#
# Free key: https://aistudio.google.com/apikey
# Use your OWN key. Quotas are per Google Cloud project, so a shared key
# means a shared limit.
# GEMINI_API_KEY=

# Flash-Lite allows ~500 free requests/day; the full Flash models ~20.
# Measured on this task they perform identically.
SDOC_GEMINI_MODEL=gemini-3.5-flash-lite

# Requests per minute. 15 suits Flash-Lite; use 5 for a full Flash model.
SDOC_LLM_RPM=15

# live | mock | off
#   live - normal, cache first then the API
#   mock - no API calls, sender-domain heuristic, for testing the wiring
#   off  - fallback disabled, rules only (~0.013 lower)
SDOC_LLM_MODE=live

# Only if poppler is somewhere unusual; it is found automatically otherwise.
# SDOC_POPPLER_PATH=